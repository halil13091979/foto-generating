# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Server-only admin access. Never expose these values with NEXT_PUBLIC_.
ADMIN_PASSWORD=change_me_admin_password
ADMIN_SESSION_SECRET=replace_with_long_random_string_32_plus_chars

# AI image generation
AI_PROVIDER=openai
AI_API_KEY=sk-your_openai_key_here
AI_IMAGE_PROVIDER=openai
AI_IMAGE_MODEL=gpt-image-1

# Email / transactional mail
# Supported providers: Yandex, Mail.ru, custom SMTP, SendGrid SMTP relay.
EMAIL_PROVIDER=smtp

# Example for Yandex:
# SMTP_SERVICE=
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# Example for Mail.ru:
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true

# Example for SendGrid SMTP relay:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your_sendgrid_api_key_here
# SMTP_FROM=noreply@your-domain.com

SMTP_SERVICE=
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=hello@sooli.ru
SMTP_PASSWORD=replace_with_real_smtp_password
SMTP_FROM=no-reply@sooli.ru
SMTP_FROM_NAME=Sooli
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Payments / subscriptions
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
TINKOFF_TERMINAL_KEY=
TINKOFF_SECRET_KEY=

# Platega / payment gateway
PLATEGA_API_KEY=
PLATEGA_SECRET_KEY=
PLATEGA_MERCHANT_ID=
PLATEGA_WEBHOOK_SECRET=
PLATEGA_BASE_URL=https://api.platega.com
PLATEGA_TEST_MODE=true

# Storage / file uploads
STORAGE_BUCKET=sooli-local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Internal currency
RAYS_WELCOME_BONUS=6
ALLOW_DIRECT_RAYS_TOPUP=false
INTERNAL_API_SECRET=replace_with_long_random_internal_secret
